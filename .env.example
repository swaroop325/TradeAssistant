# TradeAssistant - Environment Variables
# Copy to .env.local and fill in values

# VAPID Keys - Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# App URLs (auto-filled by deploy.sh after first deploy)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=

# WebAuthn (auto-filled by deploy.sh after first deploy)
RP_ID=
RP_NAME=TradeAssistant
ORIGIN=
